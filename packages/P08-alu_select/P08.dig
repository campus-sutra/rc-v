    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>P08 ALU result selector - Digital task
4-bit version: decode aluop into a select code, then multiplexers; zero is a NOR of all bits.
Allowed parts: gates + Multiplexer, Demultiplexer, Decoder, PriorityEncoder
Do not rename, move or delete the input and output pins.</string>
        </entry>
      </elementAttributes>
      <pos x="80" y="-60"/>
