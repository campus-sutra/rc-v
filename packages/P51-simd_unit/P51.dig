  <wires>
    <!-- Input a into Splitter A -->
    <wire><p1 x="100" y="100"/><p2 x="160" y="100"/></wire>
    <!-- Input b into Splitter B -->
    <wire><p1 x="100" y="160"/><p2 x="160" y="160"/></wire>

    <!-- a0 (Splitter A out 0 at 180, 100) distribution -->
    <wire><p1 x="180" y="100"/><p2 x="220" y="100"/></wire>
    <wire><p1 x="220" y="100"/><p2 x="340" y="100"/></wire>
    <wire><p1 x="220" y="100"/><p2 x="220" y="300"/></wire>
    <wire><p1 x="220" y="300"/><p2 x="440" y="300"/></wire>
    <wire><p1 x="440" y="300"/><p2 x="480" y="300"/></wire>
    <wire><p1 x="440" y="300"/><p2 x="440" y="340"/></wire>
    <wire><p1 x="440" y="340"/><p2 x="600" y="340"/></wire>

    <!-- b0 (Splitter B out 0 at 180, 160) distribution -->
    <wire><p1 x="180" y="160"/><p2 x="240" y="160"/></wire>
    <wire><p1 x="240" y="160"/><p2 x="240" y="120"/></wire>
    <wire><p1 x="240" y="120"/><p2 x="340" y="120"/></wire>
    <wire><p1 x="240" y="160"/><p2 x="240" y="280"/></wire>
    <wire><p1 x="240" y="280"/><p2 x="240" y="320"/></wire>
    <wire><p1 x="240" y="320"/><p2 x="480" y="320"/></wire>
    <wire><p1 x="240" y="280"/><p2 x="580" y="280"/></wire>
    <wire><p1 x="580" y="280"/><p2 x="580" y="300"/></wire>
    <wire><p1 x="580" y="300"/><p2 x="600" y="300"/></wire>

    <!-- a1 (Splitter A out 1 at 180, 120) distribution -->
    <wire><p1 x="180" y="120"/><p2 x="260" y="120"/></wire>
    <wire><p1 x="260" y="120"/><p2 x="260" y="200"/></wire>
    <wire><p1 x="260" y="200"/><p2 x="340" y="200"/></wire>
    <wire><p1 x="260" y="200"/><p2 x="260" y="440"/></wire>
    <wire><p1 x="260" y="440"/><p2 x="440" y="440"/></wire>
    <wire><p1 x="440" y="440"/><p2 x="480" y="440"/></wire>
    <wire><p1 x="440" y="440"/><p2 x="440" y="480"/></wire>
    <wire><p1 x="440" y="480"/><p2 x="600" y="480"/></wire>

    <!-- b1 (Splitter B out 1 at 180, 180) distribution -->
    <wire><p1 x="180" y="180"/><p2 x="280" y="180"/></wire>
    <wire><p1 x="280" y="180"/><p2 x="280" y="220"/></wire>
    <wire><p1 x="280" y="220"/><p2 x="340" y="220"/></wire>
    <wire><p1 x="280" y="220"/><p2 x="280" y="420"/></wire>
    <wire><p1 x="280" y="420"/><p2 x="280" y="460"/></wire>
    <wire><p1 x="280" y="460"/><p2 x="480" y="460"/></wire>
    <wire><p1 x="280" y="420"/><p2 x="580" y="420"/></wire>
    <wire><p1 x="580" y="420"/><p2 x="580" y="440"/></wire>
    <wire><p1 x="580" y="440"/><p2 x="600" y="440"/></wire>

    <!-- Adder 0 carry-in Ground -->
    <wire><p1 x="320" y="140"/><p2 x="340" y="140"/></wire>
    <!-- Adder 1 carry-in Ground -->
    <wire><p1 x="320" y="240"/><p2 x="340" y="240"/></wire>

    <!-- Comparator 0 greater-than to Mux 0 select -->
    <wire><p1 x="540" y="300"/><p2 x="560" y="300"/></wire>
    <wire><p1 x="560" y="300"/><p2 x="560" y="360"/></wire>
    <wire><p1 x="560" y="360"/><p2 x="620" y="360"/></wire>
    <wire><p1 x="620" y="360"/><p2 x="620" y="340"/></wire>

    <!-- Comparator 1 greater-than to Mux 1 select -->
    <wire><p1 x="540" y="440"/><p2 x="560" y="440"/></wire>
    <wire><p1 x="560" y="440"/><p2 x="560" y="500"/></wire>
    <wire><p1 x="560" y="500"/><p2 x="620" y="500"/></wire>
    <wire><p1 x="620" y="500"/><p2 x="620" y="480"/></wire>

    <!-- Sum routing to Sum Splitter -->
    <wire><p1 x="400" y="100"/><p2 x="820" y="100"/></wire>
    <wire><p1 x="400" y="200"/><p2 x="780" y="200"/></wire>
    <wire><p1 x="780" y="200"/><p2 x="780" y="120"/></wire>
    <wire><p1 x="780" y="120"/><p2 x="820" y="120"/></wire>
    <wire><p1 x="840" y="100"/><p2 x="900" y="100"/></wire>

    <!-- Max routing to Max Splitter -->
    <wire><p1 x="640" y="320"/><p2 x="760" y="320"/></wire>
    <wire><p1 x="760" y="320"/><p2 x="760" y="160"/></wire>
    <wire><p1 x="760" y="160"/><p2 x="820" y="160"/></wire>
    <wire><p1 x="640" y="460"/><p2 x="740" y="460"/></wire>
    <wire><p1 x="740" y="460"/><p2 x="740" y="180"/></wire>
    <wire><p1 x="740" y="180"/><p2 x="820" y="180"/></wire>
    <wire><p1 x="840" y="160"/><p2 x="900" y="160"/></wire>
  </wires>
  <measurementOrdering/>
</circuit>
