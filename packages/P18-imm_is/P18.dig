      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>P18 Immediate generator I/S - Digital task
Full size, Splitters only: sign extension is just copying bit 31 into the upper bits.
Allowed parts: Splitter, Tunnel, Const, Ground, VDD, Text, In, Out, Clock
Do not rename, move or delete the input and output pins.</string>
        </entry>
      </elementAttributes>
      <pos x="100" y="40" />
    </visualElement>
